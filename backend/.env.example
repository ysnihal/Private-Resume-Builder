# Copy this file to ".env" (same folder) and fill in at least GEMINI_API_KEY.
# ".env" itself is gitignored - it never gets committed. This example file
# IS committed, so anyone setting up this project knows what's needed.

LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# The three below are wired up but not implemented for real generation yet
# (only Gemini supports the structured JSON output the app actually uses).
# Leave them blank unless you're extending the app yourself.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
